@implements IDisposable
<div class="campo">
    @if (!string.IsNullOrWhiteSpace(Etiqueta))
    {
        <label for="@_id">@Etiqueta</label>
    }
    @* @key cambia SOLO cuando el padre reescribe el valor por su cuenta (ver
       OnParametersSet) y sirve para forzar que el navegador reciba el valor
       nuevo. Hace falta porque _valorMostrado no se toca al teclear: el DOM
       del navegador se ha ido por su lado, y devolverlo al mismo valor que
       Blazor ya tenía renderizado no produce diff ninguno — el <input> se
       quedaría con lo tecleado pese a que el padre lo acaba de limpiar. Con
       @key el elemento se recrea y nace con el valor correcto. *@
    <input @key="_generacionValor"
           id="@_id"
           type="@Type"
           class="@ClaseCompleta"
           value="@_valorMostrado"
           placeholder="@Placeholder"
           disabled="@Deshabilitado"
           @oninput="ManejarCambioAsync"
           @onblur="ManejarBlurAsync"
           @attributes="AtributosSinClase" />
    @if (TieneError)
    {
        <span class="campo-mensaje-error" role="alert">@MensajeError</span>
    }
</div>

@code {
    private const int DebounceMilisegundos = 300;

    private readonly string _id = $"campo-{Guid.NewGuid():N}";
    private CancellationTokenSource? _debounceCts;
    private string _ultimoValor = string.Empty;
    private string _valorMostrado = string.Empty;
    private string _ultimoValorNotificado = string.Empty;

    /// <summary>
    /// Se incrementa en cada resincronización venida del padre — ver el @key
    /// del &lt;input&gt;. No cuenta pulsaciones: solo las veces que el valor
    /// cambió por una razón ajena a lo que el usuario está escribiendo.
    /// </summary>
    private int _generacionValor;

    [Parameter] public string? Etiqueta { get; set; }
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValorChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public string? MensajeError { get; set; }

    /// <summary>
    /// Se dispara al perder el foco, después de <see cref="ValorChanged"/> —
    /// para que el padre pueda validar el campo "al salir de él" (UX_PATTERNS.md,
    /// P1-18 de docs/business/MATURITY_REVIEW.md) sin acoplar esta clase a
    /// FluentValidation ni a ningún mecanismo de validación concreto.
    /// </summary>
    [Parameter] public EventCallback OnBlur { get; set; }

    /// <summary>Attribute splatting — ver el comentario de Boton.razor, mismo criterio (P2 #28 de docs/business/MATURITY_REVIEW.md), incluido el merge manual de "class".</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AtributosAdicionales { get; set; }

    private bool TieneError => !string.IsNullOrWhiteSpace(MensajeError);

    private string ClaseCompleta
    {
        get
        {
            var claseBase = TieneError ? "campo-input campo-input-error" : "campo-input";
            return AtributosAdicionales is not null
                && AtributosAdicionales.TryGetValue("class", out var claseLlamador)
                && claseLlamador is string claseLlamadorTexto
                && !string.IsNullOrWhiteSpace(claseLlamadorTexto)
                ? $"{claseBase} {claseLlamadorTexto}"
                : claseBase;
        }
    }

    private Dictionary<string, object>? AtributosSinClase =>
        AtributosAdicionales is null || !AtributosAdicionales.ContainsKey("class")
            ? AtributosAdicionales
            : AtributosAdicionales.Where(kvp => kvp.Key != "class").ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

    /// <summary>
    /// El valor mostrado en el input solo se resincroniza con el
    /// parámetro Valor cuando este cambia por una razón ajena a nuestro
    /// propio debounce (p. ej. el padre limpia el filtro) — si se
    /// resincronizara en cada render, un re-render disparado mientras el
    /// debounce todavía está pendiente (p. ej. al cancelarse el delay de
    /// una tecla anterior por escritura rápida) reescribiría el input con
    /// el valor todavía viejo del padre y borraría lo que el usuario
    /// acaba de teclear.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Valor != _ultimoValorNotificado)
        {
            _valorMostrado = Valor;
            _ultimoValor = Valor;
            _ultimoValorNotificado = Valor;
            _generacionValor++;
        }
    }

    private async Task ManejarCambioAsync(ChangeEventArgs e)
    {
        // _valorMostrado (lo que se re-pinta en el <input>) NO se toca aquí
        // a propósito: el navegador ya tiene el valor correcto en su propio
        // DOM porque el usuario lo acaba de teclear. Si lo reflejáramos de
        // vuelta en cada pulsación, cada tecla dispara un render que reenvía
        // "value" al cliente — y bajo latencia, un render en cola de una
        // pulsación anterior puede aplicarse después de uno más reciente,
        // pisando visualmente lo que el usuario ya ve con una versión más
        // corta (bug real, visto con tecla mantenida + latencia simulada:
        // el servidor procesa todo en orden perfecto, pero el cliente llega
        // a mostrar un valor más corto un instante antes de alcanzar el
        // real). _valorMostrado solo se actualiza en OnParametersSet, es
        // decir, cuando el valor cambia por una razón ajena a esta misma
        // pulsación.
        _ultimoValor = e.Value?.ToString() ?? string.Empty;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        _debounceCts = cts;

        try
        {
            await Task.Delay(DebounceMilisegundos, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        // Ver ManejarBlurAsync: Cancel() y el propio vencimiento del delay
        // pueden solaparse — el temporizador puede completar sin lanzar
        // justo cuando el blur ya está cancelando, y sin esto los dos
        // notificarían el mismo valor (bug real, visto en CI: ValorChanged
        // invocado dos veces con el mismo valor tras perder el foco).
        if (cts.Token.IsCancellationRequested) return;

        _ultimoValorNotificado = _ultimoValor;
        await ValorChanged.InvokeAsync(_ultimoValor);
    }

    /// <summary>
    /// Al perder el foco (p. ej. al hacer clic en "Guardar") se cancela el
    /// debounce pendiente y se notifica el valor ya mismo — si no, un clic
    /// rápido tras escribir podría llegar al padre antes que la última
    /// tecla, enviando un valor desactualizado.
    /// </summary>
    private async Task ManejarBlurAsync()
    {
        _debounceCts?.Cancel();
        _ultimoValorNotificado = _ultimoValor;
        await ValorChanged.InvokeAsync(_ultimoValor);
        await OnBlur.InvokeAsync();
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
